{
  "name": "simple-markdown-viewer",
  "version": "1.1.0",
  "description": "Simple Markdown Viewer - A powerful desktop markdown viewer built with NW.js",
  "author": "Derek Bowes <db@bowesmail.com> (SubsKeepr Inc.)",
  "license": "MIT",
  "main": "index.html",
  "scripts": {
    "start": "nw .",
    "build": "nwbuild \"./**/*\" --platforms win64 --buildDir dist/"
  },
  "window": {
    "title": "Simple Markdown Viewer",
    "width": 1200,
    "height": 900,
    "toolbar": true,
    "icon": "icon.png"
  },
  "devDependencies": {
    "nw": "^0.104.1-sdk",
    "nw-builder": "^4.17.10"
  },
  "dependencies": {
    "highlight.js": "^11.11.0",
    "katex": "^0.17.0",
    "marked": "^16.4.0",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KrunchMuffin/simple-markdown-viewer.git"
  },
  "keywords": [
    "markdown",
    "viewer",
    "editor",
    "nwjs",
    "desktop",
    "mermaid",
    "syntax-highlighting",
    "documentation"
  ],
  "bugs": {
    "url": "https://github.com/KrunchMuffin/simple-markdown-viewer/issues"
  },
  "homepage": "https://github.com/KrunchMuffin/simple-markdown-viewer#readme"
}
