{
  "name": "simple-markdown-viewer",
  "version": "1.1.0",
  "description": "A lightweight Markdown, text, and source code viewer built with Neutralinojs",
  "author": "Derek Bowes <db@bowesmail.com> (SubsKeepr Inc.)",
  "license": "MIT",
  "scripts": {
    "bundle": "node scripts/build-frontend.js",
    "start": "npm run bundle && neu run",
    "build:app": "npm run bundle && neu build --embed-resources",
    "build": "npm run build:app && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test": "node tests/markdown-math.test.js && node tests/document-support.test.js"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.17.0",
    "marked": "^18.0.9",
    "marked-katex-extension": "^5.1.10",
    "mermaid": "^11.16.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KrunchMuffin/simple-markdown-viewer.git"
  },
  "keywords": [
    "markdown",
    "text-viewer",
    "source-code",
    "viewer",
    "editor",
    "neutralinojs",
    "desktop",
    "mermaid",
    "syntax-highlighting",
    "documentation"
  ],
  "bugs": {
    "url": "https://github.com/KrunchMuffin/simple-markdown-viewer/issues"
  },
  "homepage": "https://github.com/KrunchMuffin/simple-markdown-viewer#readme"
}
